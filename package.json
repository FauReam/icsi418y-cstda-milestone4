{
  "name": "cstda-milestone4",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "seed": "npm run seed -w server --",
    "test": "npm test -w server",
    "db:up": "node scripts/database.js up",
    "db:down": "node scripts/database.js down"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
